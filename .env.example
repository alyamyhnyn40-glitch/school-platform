APP_ENV=production
APP_DEBUG=0
APP_URL=https://school.example.com
APP_BASE_PATH=
APP_TIMEZONE=Asia/Aden
APP_ENC_KEY=
SESSION_IDLE_MINUTES=30

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_platform
DB_USER=
DB_PASS=

# SMS: log (للتطوير) أو http (مزود حقيقي)
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_HEADERS={"Authorization":"Bearer TOKEN"}
SMS_HTTP_BODY={"to":"{to}","message":"{message}"}
SMS_HTTP_SUCCESS_CODE=200
