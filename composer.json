{
  "name": "school-platform/app",
  "description": "منصة إدارة المدارس والتعليم عن بُعد",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "phpmailer/phpmailer": "^6.10"
  },
  "require-dev": { "phpunit/phpunit": "^11.0" },
  "autoload": { "psr-4": { "App\\": "app/" }, "files": ["app/helpers.php"] },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "config": { "optimize-autoloader": true, "sort-packages": true }
}
